# Banco de dados
DB_HOST=localhost
DB_NAME=HelpTI
DB_USER=helpti_app
DB_PASSWORD=senha-do-banco
DB_PORT=3306

# Remetente SMTP temporario do projeto
# O dominio precisa existir e ter um servico de email configurado.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=nome.integrante@helpTI.com
SMTP_PASSWORD=senha-da-conta-ou-senha-de-aplicativo
SMTP_FROM=nome.integrante@helpTI.com
SMTP_TLS=true
SMTP_AUTH=true

