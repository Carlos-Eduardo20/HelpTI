# SQLite é o padrão e não exige servidor de banco; o arquivo é criado automaticamente.
# DB_SQLITE_PATH=instance/helpti.sqlite3
#
# A demonstração cria somente a conta local teste@helpiti.com; não cria chamados ou clientes.
# Este arquivo é apenas um modelo; nunca coloque credenciais reais no Git.
#
# Mantenha o modo de demonstração ligado somente em desenvolvimento local.
# Em hospedagem pública, defina HELPTI_DEMO_MODE=false.
# HELPTI_DEMO_MODE=true
#
# Ative somente quando o site estiver atrás de HTTPS/TLS.
# HELPTI_HTTPS_ONLY=false
#
# E-mail opcional para avisos de chamados.
# Exemplo com Zoho Mail (use uma senha de aplicativo gerada na conta Zoho).
# Contas brasileiras/UE podem usar smtp.zoho.com.br / smtp.zoho.eu; porta 465 usa SSL.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=seu-email@seudominio.com
# SMTP_PASSWORD=senha-de-aplicativo-zoho
# SMTP_FROM=seu-email@seudominio.com

# Opção para hospedagem gratuita do Render: envio HTTPS pela API do Zoho Mail.
# Crie um cliente OAuth com o escopo ZohoMail.messages.CREATE e use o refresh token.
# No Render, cadastre estes valores em Environment (não os coloque no Git).
# EMAIL_PROVIDER=zoho_api
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com
# ZOHO_MAIL_ACCOUNT_ID=
# ZOHO_MAIL_FROM_ADDRESS=seu-email@seudominio.com
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
