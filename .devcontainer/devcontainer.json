{
  "name": "HelpTI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {},
  "updateContentCommand": "python -m pip install --disable-pip-version-check --no-input -r backend/requirements.txt",
  "containerEnv": {
    "HELPTI_HOST": "0.0.0.0",
    "HELPTI_DEBUG": "false",
    "HELPTI_HTTPS_ONLY": "true",
    "HELPTI_RUNTIME_ENV": "codespace",
    "HELPTI_DEMO_MODE": "prompt",
    "PIP_NO_CACHE_DIR": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.analysis.autoImportCompletions": false,
        "python.analysis.diagnosticMode": "openFilesOnly",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/__pycache__/**": true,
          "**/.venv/**": true,
          "**/data/**": true
        },
        "search.exclude": {
          "**/.venv": true,
          "**/__pycache__": true
        }
      }
    }
  },
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "HelpTI",
      "visibility": "private",
      "onAutoForward": "openBrowser"
    }
  }
}