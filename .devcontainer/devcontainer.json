{
  "name": "HelpTI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r backend/requirements.txt",
  "containerEnv": {
    "HELPTI_HOST": "0.0.0.0",
    "HELPTI_DEBUG": "false"
  },
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "HelpTI",
      "onAutoForward": "openBrowser"
    }
  }
}
