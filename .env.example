# Copie para .env na raiz do projeto. Nunca envie o arquivo .env ao Git.
# Docker Compose lê este arquivo automaticamente para substituir as variáveis.
HELPTI_DEMO_MODE=true
HELPTI_HTTPS_ONLY=false
HELPTI_DB_PATH=

# Gere uma chave longa e aleatória para produção; mantenha-a entre reinicializações.
FLASK_SECRET_KEY=

# SMTP para códigos de confirmação de cadastro, recuperação de senha e avisos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: contas Microsoft pessoais (Outlook/Hotmail/Live) e contas corporativas M365.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
