# Copie para .env na raiz do projeto. Nunca envie o arquivo .env ao Git.
# Docker Compose lê este arquivo automaticamente para substituir as variáveis.
HELPTI_DEMO_MODE=false
HELPTI_HTTPS_ONLY=false

# MySQL. No Docker Compose o servidor "db" é criado automaticamente.
DB_NAME=helpti_app
DB_USER=helpti
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Gere uma chave longa e aleatória para produção; mantenha-a entre reinicializações.
FLASK_SECRET_KEY=

# SMTP para códigos de confirmação de cadastro, recuperação de senha e avisos (exemplo: Zoho Mail).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: contas Microsoft pessoais (Outlook/Hotmail/Live) e contas corporativas M365.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
