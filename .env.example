# Copie para .env na raiz do projeto. Nunca envie o arquivo .env ao Git.
# Docker Compose lê este arquivo automaticamente para substituir as variáveis.
HELPTI_DEMO_MODE=false
HELPTI_HTTPS_ONLY=false

# Gere uma chave longa e aleatória para produção; mantenha-a entre reinicializações.
FLASK_SECRET_KEY=

# SMTP opcional para avisos de chamados (exemplo: Zoho Mail).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
